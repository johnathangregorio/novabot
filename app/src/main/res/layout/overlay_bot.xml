<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <!-- Collapsed pill — always visible -->
    <ImageView
        android:id="@+id/overlay_pill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/overlay_pill_bg"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:src="@drawable/ic_nova_spark"
        android:layout_gravity="top|center_horizontal"
        android:elevation="10dp" />

    <!-- Slow Mode countdown badge — small corner badge on the collapsed pill, so the
         random min/max delay is visible at a glance without opening the panel. Only
         shown while Slow Mode is running; hidden otherwise. -->
    <TextView
        android:id="@+id/overlay_countdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="-6dp"
        android:background="@drawable/overlay_countdown_bg"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:text="🐢 0s"
        android:textColor="#FFFFFF"
        android:textSize="10sp"
        android:textStyle="bold"
        android:elevation="11dp"
        android:visibility="gone" />

    <!-- Expanded panel — opens downward from top-center pill -->
    <LinearLayout
        android:id="@+id/overlay_panel"
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="52dp"
        android:orientation="vertical"
        android:background="@drawable/overlay_panel_bg"
        android:padding="12dp"
        android:elevation="8dp"
        android:visibility="gone">

        <!-- Status -->
        <TextView
            android:id="@+id/overlay_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ready"
            android:textColor="#AAAAAA"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:paddingBottom="4dp" />

        <!-- Last action / result -->
        <TextView
            android:id="@+id/overlay_last_action"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tap Start Bot to begin"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:paddingBottom="10dp"
            android:maxLines="3"
            android:ellipsize="end" />

        <!-- Start / Stop — primary action -->
        <Button
            android:id="@+id/overlay_btn_start"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="▶ Start Bot"
            android:textSize="13sp"
            android:backgroundTint="#1B5E20"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:insetTop="0dp"
            android:insetBottom="0dp" />

        <!-- Settings -->
        <Button
            android:id="@+id/overlay_btn_settings"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_marginTop="6dp"
            android:text="⚙️ Settings"
            android:textSize="11sp"
            android:backgroundTint="#333333"
            android:textColor="#CCCCCC"
            android:insetTop="0dp"
            android:insetBottom="0dp" />

        <!-- Close -->
        <Button
            android:id="@+id/overlay_btn_close"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:layout_marginTop="4dp"
            android:text="✕  Close"
            android:textSize="10sp"
            android:backgroundTint="#5C2A2A"
            android:textColor="#E8C9C9"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp" />

    </LinearLayout>

</FrameLayout>
