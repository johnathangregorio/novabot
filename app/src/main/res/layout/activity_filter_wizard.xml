<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="@color/bg_screen"
    android:padding="16dp">

    <!-- Top bar: page indicator + skip link -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/tv_page_indicator"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Question 1 of 5"
            android:textSize="12sp"
            android:textColor="@color/text_hint"
            android:letterSpacing="0.05" />

        <TextView
            android:id="@+id/tv_skip_wizard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Skip Setup"
            android:textSize="13sp"
            android:textColor="@color/text_section"
            android:clickable="true"
            android:focusable="true"
            android:padding="4dp" />

    </LinearLayout>

    <!-- Question card -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/bg_card"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/card_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:id="@+id/page_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Page 1 — Min payout -->
                <LinearLayout
                    android:id="@+id/page_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="What's the lowest payout you'll accept?"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:lineSpacingExtra="4dp"
                        android:layout_marginBottom="18dp" />

                    <EditText
                        android:id="@+id/et_wizard_min_payout"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:inputType="numberDecimal"
                        android:hint="$30.00"
                        android:textSize="18sp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_hint"
                        android:background="@color/bg_screen"
                        android:padding="12dp" />

                </LinearLayout>

                <!-- Page 2 — Max miles -->
                <LinearLayout
                    android:id="@+id/page_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="What's the farthest you'll drive?"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:lineSpacingExtra="4dp"
                        android:layout_marginBottom="18dp" />

                    <EditText
                        android:id="@+id/et_wizard_max_miles"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:inputType="numberDecimal"
                        android:hint="20 miles"
                        android:textSize="18sp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_hint"
                        android:background="@color/bg_screen"
                        android:padding="12dp" />

                </LinearLayout>

                <!-- Page 3 — Zones -->
                <LinearLayout
                    android:id="@+id/page_3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Any zones to always include or always skip?"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:lineSpacingExtra="4dp"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Both optional — leave blank to accept every zone."
                        android:textSize="13sp"
                        android:textColor="@color/text_hint"
                        android:layout_marginBottom="18dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Allowed zones"
                        android:textSize="12sp"
                        android:textColor="@color/text_section"
                        android:layout_marginBottom="6dp" />

                    <EditText
                        android:id="@+id/et_wizard_allowed_zones"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:hint="e.g. Downtown, North Side"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_hint"
                        android:background="@color/bg_screen"
                        android:padding="10dp"
                        android:layout_marginBottom="16dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Blocked zones"
                        android:textSize="12sp"
                        android:textColor="@color/text_section"
                        android:layout_marginBottom="6dp" />

                    <EditText
                        android:id="@+id/et_wizard_blocked_zones"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:hint="e.g. Industrial Park"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_hint"
                        android:background="@color/bg_screen"
                        android:padding="10dp" />

                </LinearLayout>

                <!-- Page 4 — Scan days -->
                <LinearLayout
                    android:id="@+id/page_4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Which days do you want the bot scanning for offers?"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:lineSpacingExtra="4dp"
                        android:layout_marginBottom="16dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="10dp">
                        <CheckBox
                            android:id="@+id/cb_wizard_select_all"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Select All"
                            android:textSize="14sp"
                            android:textColor="@color/text_secondary"
                            android:paddingStart="6dp" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/divider_line"
                        android:layout_marginBottom="10dp" />

                    <LinearLayout
                        android:id="@+id/ll_wizard_scan_days"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                </LinearLayout>

                <!-- Page 5 — Pickup time -->
                <LinearLayout
                    android:id="@+id/page_5"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Any pickup-time restriction?"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:lineSpacingExtra="4dp"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Off means any pickup time is accepted, on every scanned day."
                        android:textSize="13sp"
                        android:textColor="@color/text_hint"
                        android:layout_marginBottom="16dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="14dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Restrict to a specific window"
                            android:textSize="14sp"
                            android:textColor="@color/text_primary" />
                        <Switch
                            android:id="@+id/sw_wizard_pickup_restrict"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/ll_wizard_pickup_time"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:visibility="gone">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_wizard_pickup_start"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:text="7:00 AM"
                            android:textSize="13sp"
                            android:backgroundTint="@color/btn_accent_bg"
                            android:textColor="@color/text_section"
                            android:insetTop="0dp"
                            android:insetBottom="0dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="–"
                            android:textSize="14sp"
                            android:textColor="@color/text_hint"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_wizard_pickup_stop"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:text="10:00 PM"
                            android:textSize="13sp"
                            android:backgroundTint="@color/btn_accent_bg"
                            android:textColor="@color/text_section"
                            android:insetTop="0dp"
                            android:insetBottom="0dp" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </ScrollView>

    <!-- Bottom nav -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="14dp">

        <Button
            android:id="@+id/btn_wizard_back"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="Back"
            android:textColor="@color/text_secondary"
            android:backgroundTint="@color/bg_card"
            android:insetTop="0dp"
            android:insetBottom="0dp" />

        <Button
            android:id="@+id/btn_wizard_next"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Next"
            android:textStyle="bold"
            android:backgroundTint="@color/text_section"
            android:textColor="@color/text_on_section"
            android:insetTop="0dp"
            android:insetBottom="0dp" />

    </LinearLayout>

</LinearLayout>
