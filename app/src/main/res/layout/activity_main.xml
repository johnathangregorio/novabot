<?xml version="1.0" encoding="utf-8"?>
<!-- MainActivity is a pure router now — OnboardingWizardActivity covers first-run setup
     (permissions/Telegram/filters) end to end, and SettingsActivity is the app's
     real home once everything is done. This screen is only ever visible for a brief moment
     while that routing decision is being made. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginBottom="20dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="@string/app_name" />

        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminateTint="@color/text_section" />

    </LinearLayout>

</FrameLayout>
